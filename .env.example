# Random string you invent. It becomes part of the public webhook path,
# which is the only thing standing between your Chat space and the internet.
# Generate one with: openssl rand -hex 24
INBOUND_SECRET=

# Google Chat space > Apps & integrations > Webhooks > Add webhooks > copy URL
GCHAT_WEBHOOK_URL=

# Optional. Comma-separated HeyReach event types to forward. Empty = forward all.
EVENT_ALLOWLIST=CONNECTION_REQUEST_ACCEPTED,EVERY_MESSAGE_REPLY_RECEIVED,LEAD_TAG_UPDATED

# Group all events for one lead into a single Chat thread.
THREAD_BY_LEAD=true

# Turn on temporarily to log raw HeyReach payloads and check field mapping.
LOG_PAYLOADS=false
